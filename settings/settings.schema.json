{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mitm": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "The type of MITM service to use.",
          "enum": ["amatsuki", "majsoul", "riichi_city", "tenhou", "unified"]
        },
        "host": {
          "type": "string",
          "description": "The hostname for the MITM service.",
          "format": "hostname"
        },
        "port": {
          "type": "integer",
          "description": "The port number for the MITM service.",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": ["type", "host", "port"],
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "description": "The model to use for analyzing the game."
    },
    "theme": {
      "type": "string",
      "description": "The theme to use for the application."
    },
    "ot_server": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "description": "The server URL for the online service.",
          "format": "uri"
        },
        "online": {
          "type": "boolean",
          "description": "Whether to use the online service."
        },
        "api_key": {
          "type": "string",
          "description": "The API key for the online service."
        }
      },
      "required": ["server", "online", "api_key"],
      "additionalProperties": false
    },
    "dataserver": {
      "type": "object",
      "description": "Settings for the SSE dataserver that streams recommendations.",
      "properties": {
        "enable": {
          "type": "boolean",
          "description": "Whether to enable the SSE dataserver for streaming recommendations."
        },
        "host": {
          "type": "string",
          "description": "The hostname or interface for the dataserver to bind."
        },
        "port": {
          "type": "integer",
          "description": "The port number for the dataserver.",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": ["enable", "host", "port"],
      "additionalProperties": false
    },
    "autoplay": {
      "type": "boolean",
      "description": "Whether to enable autoplay for the game."
    },
    "auto_switch_model": {
      "type": "boolean",
      "description": "Whether to automatically switch the model based on the game."
    },
    "autoplay_thinker": {
      "type": "string",
      "description": "Simulates human-like decision-making delays for an autoplay bot. Input `thinker` will use the thinker.py file in the autoplay/delay directory."
    },
    "default_thinker": {
      "type": "object",
      "properties": {
        "max_delay": {
          "type": "number",
          "description": "Maximum delay in seconds."
        },
        "min_delay": {
          "type": "number",
          "description": "Minimum delay in seconds."
        },
        "add_random_delay": {
          "type": "boolean",
          "description": "Whether to add random delays."
        },
        "add_random_delay_min": {
          "type": "number",
          "description": "Minimum random delay in seconds."
        },
        "add_random_delay_max": {
          "type": "number",
          "description": "Maximum random delay in seconds."
        },
        "first_tile_discard": {
          "type": "number",
          "description": "Delay for first tile discard."
        },
        "can_riichi_think": {
          "type": "number",
          "description": "Thinking time for riichi decision."
        },
        "close_q_threshold": {
          "type": "number",
          "description": "Threshold for close qvalue."
        },
        "two_close_q_think": {
          "type": "number",
          "description": "Thinking time for two close qvalue."
        },
        "confident_q_threshold": {
          "type": "number",
          "description": "Threshold for confident qvalue."
        },
        "confident_q_max_delay": {
          "type": "number",
          "description": "Maximum delay for confident qvalue."
        },
        "kan_think": {
          "type": "number",
          "description": "Thinking time for kan."
        }
      },
      "required": ["max_delay", "min_delay", "add_random_delay", "add_random_delay_min", "add_random_delay_max", "first_tile_discard", "can_riichi_think", "close_q_threshold", "two_close_q_think", "confident_q_threshold", "confident_q_max_delay", "kan_think"],
      "additionalProperties": false
    },
    "recommendation_temperature": {
      "type": "number",
      "description": "Temperature setting for recommendation softmax scaling."
    }
  },
  "required": ["mitm", "model", "theme", "ot_server", "dataserver", "autoplay", "auto_switch_model", "autoplay_thinker", "default_thinker", "recommendation_temperature"],
  "description": "Settings for the application.",
  "additionalProperties": false
}
